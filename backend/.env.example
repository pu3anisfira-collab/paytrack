# Database
DATABASE_URL="postgresql://petronas_user:petronas_pass@localhost:5432/petronas_tracker?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-string"
JWT_EXPIRES_IN="24h"

# CORS
FRONTEND_URL="http://localhost:5173"

# Uploads
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5

# Seed admin account (used by prisma/seed.js)
SEED_MANAGER_USERNAME="manager"
SEED_MANAGER_EMAIL="manager@petronas-station.local"
SEED_MANAGER_PASSWORD="ChangeMe123!"
SEED_STAFF_USERNAME="staff"
SEED_STAFF_EMAIL="staff@petronas-station.local"
SEED_STAFF_PASSWORD="ChangeMe123!"
